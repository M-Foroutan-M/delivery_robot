<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="augdd_hospital">

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- ============================================================
         Layout (top-down, meters):
           Main corridor:   x in [-5, 5],   y in [-0.75, 0.75]
           Branch corridor: x in [1.25, 2.75], y in [0.75, 4.75]  (T-junction)
           Patient room:    x in [0, 4],     y in [4.75, 7.75]
         Wall thickness 0.1m, height 1.0m.
         ============================================================ -->

    <model name="wall_north_1">
      <static>true</static>
      <pose>-1.875 0.75 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>6.25 0.1 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6.25 0.1 1.0</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_north_2">
      <static>true</static>
      <pose>3.875 0.75 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>2.25 0.1 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.25 0.1 1.0</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -0.75 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>10.0 0.1 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>10.0 0.1 1.0</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west_end">
      <static>true</static>
      <pose>-5 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 1.5 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 1.5 1.0</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east_end">
      <static>true</static>
      <pose>5 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 1.5 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 1.5 1.0</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="branch_wall_west">
      <static>true</static>
      <pose>1.25 2.75 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 4.0 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 4.0 1.0</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="branch_wall_east">
      <static>true</static>
      <pose>2.75 2.75 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 4.0 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 4.0 1.0</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="room_south_1">
      <static>true</static>
      <pose>0.625 4.75 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.25 0.1 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.25 0.1 1.0</size></box></geometry>
          <material><ambient>0.85 0.85 0.9 1</ambient><diffuse>0.85 0.85 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="room_south_2">
      <static>true</static>
      <pose>3.375 4.75 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.25 0.1 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.25 0.1 1.0</size></box></geometry>
          <material><ambient>0.85 0.85 0.9 1</ambient><diffuse>0.85 0.85 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="room_north">
      <static>true</static>
      <pose>2 7.75 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>4.0 0.1 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>4.0 0.1 1.0</size></box></geometry>
          <material><ambient>0.85 0.85 0.9 1</ambient><diffuse>0.85 0.85 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="room_west">
      <static>true</static>
      <pose>0 6.25 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 3.0 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 3.0 1.0</size></box></geometry>
          <material><ambient>0.85 0.85 0.9 1</ambient><diffuse>0.85 0.85 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="room_east">
      <static>true</static>
      <pose>4 6.25 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 3.0 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 3.0 1.0</size></box></geometry>
          <material><ambient>0.85 0.85 0.9 1</ambient><diffuse>0.85 0.85 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Static obstacles (representing carts/equipment in the corridor) -->
    <model name="obstacle_cart_1">
      <static>true</static>
      <pose>-2 0.55 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.3 0.3 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.3 0.3 0.5</size></box></geometry>
          <material><ambient>0.6 0.3 0.1 1</ambient><diffuse>0.6 0.3 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_cart_2">
      <static>true</static>
      <pose>1 -0.55 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.3 0.3 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.3 0.3 0.5</size></box></geometry>
          <material><ambient>0.6 0.3 0.1 1</ambient><diffuse>0.6 0.3 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_room_furniture">
      <static>true</static>
      <pose>2 6.0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.8 0.4 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.8 0.4 0.6</size></box></geometry>
          <material><ambient>0.3 0.5 0.3 1</ambient><diffuse>0.3 0.5 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- NOT static: drag this in the Gazebo GUI during a Nav2 run to create
         an ad-hoc "dynamic obstacle" test without needing an actor plugin -->
    <model name="movable_obstacle">
      <pose>-3 -0.3 0.25 0 0 0</pose>
      <link name="link">
        <inertial><mass>2.0</mass></inertial>
        <collision name="c"><geometry><box><size>0.3 0.3 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.3 0.3 0.5</size></box></geometry>
          <material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
